use STD.Text
use GFX.Window as GameWindow

contribute GFX.Plugins {
    public use GFX.Physics.Plugin as Physics
}

protocol Described {
    func description() str
    display_name:str { get }
}

public class Player:Described {
    private var name:str
    public var health:int = 100
    public var display_name:str {
        get { return self.name }
        set(value) { self.name = value }
    }

    public init(name:str) {
        self.name = name
    }

    public func damage(amount:int = 1) {
        self.health -= amount
    }

    public func description() str {
        return "$(self.name): $(self.health)"
    }
}

func main() {
    // Build a small program that exercises the major grammar scopes.
    var player = Player(name:"Ada")
    let introduction = "
    Player: $(player.description())
    Ready for battle.
    "
    print(introduction)

    for hit in 0...3 {
        player.damage(hit)
    }

    if player.health > 0 {
        print(player.description())
    } else {
        panic("player defeated")
    }
}
